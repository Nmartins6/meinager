  organization  Organization              @relation("PricingVersionComponentOrganization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_version_components_organization_fkey")
  version       PricingCalculationVersion @relation("PricingVersionComponents", fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_version_components_version_fkey")
  sourceProduct Product?                  @relation("PricingVersionComponentSourceProduct", fields: [organizationId, sourceProductId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_version_components_source_product_fkey")

  @@unique([organizationId, id], map: "pricing_version_components_org_id_key")
  @@unique([organizationId, versionId, position], map: "pricing_version_components_org_version_position_key")
  @@index([organizationId, sourceProductId], map: "pricing_version_components_org_source_product_idx")
  @@map("pricing_version_components")
}

model PricingVersionDeduction {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  versionId      String                 @map("version_id") @db.Uuid
  position       Int
  name           String                 @db.VarChar(100)
  category       String                 @db.Text
  rate           Decimal                @db.Decimal(12, 8)
  amountExact    String                 @map("amount_exact") @db.Text
  amountDisplay  String                 @map("amount_display") @db.Text
  origin         PricingParameterOrigin
  originDetails  Json?                  @map("origin_details") @db.JsonB
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization              @relation("PricingVersionDeductionOrganization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_version_deductions_organization_fkey")
  version      PricingCalculationVersion @relation("PricingVersionDeductions", fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_version_deductions_version_fkey")

  @@unique([organizationId, id], map: "pricing_version_deductions_org_id_key")
  @@unique([organizationId, versionId, position], map: "pricing_version_deductions_org_version_position_key")
  @@map("pricing_version_deductions")
}

model PricingPriceAdoption {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  productId             String                @map("product_id") @db.Uuid
  versionId             String                @map("version_id") @db.Uuid
  previousVersionId     String?               @map("previous_version_id") @db.Uuid
  previousPrice         Decimal?              @map("previous_price") @db.Decimal(14, 2)
  newPrice              Decimal               @map("new_price") @db.Decimal(14, 2)
  classification        PricingClassification
  belowMinimumConfirmed Boolean               @default(false) @map("below_minimum_confirmed")
  justification         String?               @db.Text
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization               @relation("PricingPriceAdoptionOrganization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_price_adoptions_organization_fkey")
  product         Product                    @relation("PricingAdoptionProduct", fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_price_adoptions_product_fkey")
  version         PricingCalculationVersion  @relation("PricingAdoptionVersion", fields: [organizationId, productId, versionId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_price_adoptions_version_fkey")
  previousVersion PricingCalculationVersion? @relation("PricingAdoptionPreviousVersion", fields: [organizationId, productId, previousVersionId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_price_adoptions_previous_version_fkey")
  createdBy       User                       @relation("PricingPriceAdoptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pricing_price_adoptions_created_by_fkey")

  @@unique([organizationId, id], map: "pricing_price_adoptions_org_id_key")
  @@index([organizationId, productId, createdAt], map: "pricing_price_adoptions_org_product_created_at_idx")
  @@index([organizationId, productId, versionId], map: "pricing_price_adoptions_org_product_version_idx")
  @@index([organizationId, productId, previousVersionId], map: "pricing_price_adoptions_org_product_previous_version_idx")
  @@map("pricing_price_adoptions")
}
