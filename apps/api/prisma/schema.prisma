generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  FINANCE
  OPERATIONS
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  IN
  OUT
}

enum StockMovementOrigin {
  MANUAL
  ADJUSTMENT
  REVERSAL
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum FinancialRevenueSource {
  ENTRIES
  MANUAL_TOTAL
}

enum FinancialCategoryType {
  REVENUE
  FIXED_EXPENSE
  VARIABLE_EXPENSE
}

enum FinancialAccountType {
  CASH
  CHECKING_ACCOUNT
  SAVINGS_ACCOUNT
  DIGITAL_WALLET
  OTHER
}

enum FinancialEntryStatus {
  PENDING
  PARTIAL
  SETTLED
  CANCELLED
}

enum FinancialEntryOrigin {
  MANUAL
  DUPLICATED
  ORDER
  ADJUSTMENT
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @db.VarChar(254)
  normalizedEmail String    @unique @map("normalized_email") @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizationMember[]
  sessions    Session[]
  authTokens  AuthToken[]
  auditLogs   AuditLog[]           @relation("AuditActor")

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(150)
  slug      String             @unique @db.VarChar(80)
  document  String?            @unique @db.VarChar(14)
  segment   String?            @db.VarChar(80)
  timezone  String             @default("America/Sao_Paulo") @db.VarChar(60)
  currency  String             @default("BRL") @db.Char(3)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members              OrganizationMember[]
  auditLogs            AuditLog[]
  clients              Client[]
  products             Product[]
  stockMovements       StockMovement[]
  financialPeriods     FinancialPeriod[]
  financialCategories  FinancialCategory[]
  financialAccounts    FinancialAccount[]
  financialEntries     FinancialEntry[]
  financialSettlements FinancialSettlement[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("organization_members")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.VarChar(100)
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Client {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  type           ClientType @default(INDIVIDUAL)
  name           String     @db.VarChar(150)
  document       String?    @db.VarChar(14)
  phone          String?    @db.VarChar(20)
  email          String?    @db.VarChar(254)
  notes          String?    @db.Text
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialEntries FinancialEntry[]

  @@unique([organizationId, document])
  @@index([organizationId, name])
  @@index([organizationId, isActive])
  @@map("clients")
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  type           ProductType @default(PRODUCT)
  name           String      @db.VarChar(150)
  normalizedName String      @map("normalized_name") @db.VarChar(150)
  sku            String?     @db.VarChar(60)
  barcode        String?     @db.VarChar(50)
  unit           String      @db.VarChar(20)
  directCost     Decimal?    @map("direct_cost") @db.Decimal(18, 6)
  trackInventory Boolean     @default(false) @map("track_inventory")
  minimumStock   Decimal?    @map("minimum_stock") @db.Decimal(18, 6)
  notes          String?     @db.Text
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, normalizedName])
  @@index([organizationId, type, isActive])
  @@map("products")
}

model StockMovement {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  type           StockMovementType
  origin         StockMovementOrigin @default(MANUAL)
  quantity       Decimal             @db.Decimal(18, 6)
  reason         String              @db.VarChar(255)
  notes          String?             @db.Text
  reversalOfId   String?             @unique @map("reversal_of_id") @db.Uuid
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   StockMovement? @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal     StockMovement? @relation("StockMovementReversal")

  @@index([organizationId, productId, occurredAt, id])
  @@index([organizationId, occurredAt, id])
  @@map("stock_movements")
}

model FinancialPeriod {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  year           Int                    @db.SmallInt
  month          Int                    @db.SmallInt
  status         FinancialPeriodStatus  @default(OPEN)
  revenueSource  FinancialRevenueSource @default(ENTRIES) @map("revenue_source")
  manualRevenue  Decimal?               @map("manual_revenue") @db.Decimal(14, 2)
  closedAt       DateTime?              @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("financial_periods")
}

model FinancialCategory {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String                @db.VarChar(100)
  normalizedName String                @map("normalized_name") @db.VarChar(100)
  type           FinancialCategoryType
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]

  @@unique([organizationId, type, normalizedName])
  @@index([organizationId, isActive])
  @@map("financial_categories")
}

model FinancialAccount {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(100)
  normalizedName String               @map("normalized_name") @db.VarChar(100)
  type           FinancialAccountType
  openingBalance Decimal              @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlements  FinancialSettlement[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, isActive])
  @@map("financial_accounts")
}

model FinancialEntry {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  periodId       String               @map("period_id") @db.Uuid
  categoryId     String               @map("category_id") @db.Uuid
  clientId       String?              @map("client_id") @db.Uuid
  sourceEntryId  String?              @map("source_entry_id") @db.Uuid
  description    String               @db.VarChar(160)
  amount         Decimal              @db.Decimal(14, 2)
  dueDate        DateTime             @map("due_date") @db.Date
  status         FinancialEntryStatus @default(PENDING)
  origin         FinancialEntryOrigin @default(MANUAL)
  notes          String?              @db.Text
  cancelledAt    DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period       FinancialPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  category     FinancialCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  client       Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceEntry  FinancialEntry?       @relation("FinancialEntryDuplication", fields: [sourceEntryId], references: [id], onDelete: SetNull)
  duplicates   FinancialEntry[]      @relation("FinancialEntryDuplication")
  settlements  FinancialSettlement[]

  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@index([periodId, categoryId])
  @@index([clientId])
  @@index([sourceEntryId])
  @@map("financial_entries")
}

model FinancialSettlement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entryId        String    @map("entry_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  settledAt      DateTime  @map("settled_at") @db.Timestamptz(3)
  notes          String?   @db.Text
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversalReason String?   @map("reversal_reason") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        FinancialEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, settledAt])
  @@index([entryId, settledAt])
  @@index([accountId, settledAt])
  @@map("financial_settlements")
}
