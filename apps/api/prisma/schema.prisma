generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  FINANCE
  OPERATIONS
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  IN
  OUT
}

enum StockMovementOrigin {
  MANUAL
  ADJUSTMENT
  REVERSAL
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CommercialPriceOrigin {
  CATALOG
  MANUAL
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStageCategory {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum OrderStageTransitionType {
  CREATED
  ADVANCED
  CANCELLED
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum FinancialRevenueSource {
  ENTRIES
  MANUAL_TOTAL
}

enum FinancialCategoryType {
  REVENUE
  FIXED_EXPENSE
  VARIABLE_EXPENSE
}

enum FinancialAccountType {
  CASH
  CHECKING_ACCOUNT
  SAVINGS_ACCOUNT
  DIGITAL_WALLET
  OTHER
}

enum FinancialEntryStatus {
  PENDING
  PARTIAL
  SETTLED
  CANCELLED
}

enum FinancialEntryOrigin {
  MANUAL
  DUPLICATED
  ORDER
  ADJUSTMENT
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @db.VarChar(254)
  normalizedEmail String    @unique @map("normalized_email") @db.VarChar(254)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           OrganizationMember[]
  sessions              Session[]
  authTokens            AuthToken[]
  auditLogs             AuditLog[]                  @relation("AuditActor")
  orderStageTransitions SalesOrderStageTransition[] @relation("OrderStageTransitionActor")
  invitationsCreated    OrganizationInvitation[]    @relation("InvitationCreator")
  invitationsAccepted   OrganizationInvitation[]    @relation("InvitationAcceptor")

  organizationPricingConfigurationCreated         OrganizationPricingConfiguration[]         @relation("OrganizationPricingConfigurationCreatedBy")
  organizationPricingConfigurationUpdated         OrganizationPricingConfiguration[]         @relation("OrganizationPricingConfigurationUpdatedBy")
  organizationPricingConfigurationRevisionCreated OrganizationPricingConfigurationRevision[] @relation("OrganizationPricingConfigurationRevisionCreatedBy")
  pricingSalesProfileCreated                      PricingSalesProfile[]                      @relation("PricingSalesProfileCreatedBy")
  pricingSalesProfileUpdated                      PricingSalesProfile[]                      @relation("PricingSalesProfileUpdatedBy")
  pricingSalesProfileRevisionCreated              PricingSalesProfileRevision[]              @relation("PricingSalesProfileRevisionCreatedBy")
  productPricingCompositionCreated                ProductPricingComposition[]                @relation("ProductPricingCompositionCreatedBy")
  productPricingCompositionUpdated                ProductPricingComposition[]                @relation("ProductPricingCompositionUpdatedBy")
  pricingCalculationVersionCreated                PricingCalculationVersion[]                @relation("PricingCalculationVersionCreatedBy")
  pricingPriceAdoptionCreated                     PricingPriceAdoption[]                     @relation("PricingPriceAdoptionCreatedBy")

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(150)
  slug      String             @unique @db.VarChar(80)
  document  String?            @unique @db.VarChar(14)
  segment   String?            @db.VarChar(80)
  timezone  String             @default("America/Sao_Paulo") @db.VarChar(60)
  currency  String             @default("BRL") @db.Char(3)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members               OrganizationMember[]
  auditLogs             AuditLog[]
  clients               Client[]
  products              Product[]
  stockMovements        StockMovement[]
  financialPeriods      FinancialPeriod[]
  financialCategories   FinancialCategory[]
  financialAccounts     FinancialAccount[]
  financialEntries      FinancialEntry[]
  financialSettlements  FinancialSettlement[]
  quotes                FinancialQuote[]
  orders                SalesOrder[]
  orderWorkflows        OrderWorkflow[]
  orderWorkflowStages   OrderWorkflowStage[]
  orderStageTransitions SalesOrderStageTransition[]
  invitations           OrganizationInvitation[]

  organizationPricingConfigurationRecords         OrganizationPricingConfiguration[]         @relation("OrganizationPricingConfigurationOrganization")
  organizationPricingConfigurationRevisionRecords OrganizationPricingConfigurationRevision[] @relation("OrganizationPricingConfigurationRevisionOrganization")
  pricingSalesProfileRecords                      PricingSalesProfile[]                      @relation("PricingSalesProfileOrganization")
  pricingSalesProfileRevisionRecords              PricingSalesProfileRevision[]              @relation("PricingSalesProfileRevisionOrganization")
  pricingDeductionRecords                         PricingDeduction[]                         @relation("PricingDeductionOrganization")
  productPricingCompositionRecords                ProductPricingComposition[]                @relation("ProductPricingCompositionOrganization")
  pricingComponentRecords                         PricingComponent[]                         @relation("PricingComponentOrganization")
  pricingCalculationVersionRecords                PricingCalculationVersion[]                @relation("PricingCalculationVersionOrganization")
  pricingVersionComponentRecords                  PricingVersionComponent[]                  @relation("PricingVersionComponentOrganization")
  pricingVersionDeductionRecords                  PricingVersionDeduction[]                  @relation("PricingVersionDeductionOrganization")
  pricingPriceAdoptionRecords                     PricingPriceAdoption[]                     @relation("PricingPriceAdoptionOrganization")

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSessions Session[]    @relation("SessionActiveMembership")

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("organization_members")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  contextVersion       Int       @default(0) @map("context_version")
  tokenHash            String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz(3)
  ipAddress            String?   @map("ip_address") @db.VarChar(45)
  userAgent            String?   @map("user_agent") @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership OrganizationMember? @relation("SessionActiveMembership", fields: [activeOrganizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt])
  @@index([activeOrganizationId])
  @@map("sessions")
}

model OrganizationInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  normalizedEmail  String           @map("normalized_email") @db.VarChar(254)
  role             OrganizationRole
  tokenHash        String           @unique @map("token_hash") @db.VarChar(64)
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User         @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptor     User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([normalizedEmail, expiresAt])
  @@map("organization_invitations")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.VarChar(100)
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Client {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  type           ClientType @default(INDIVIDUAL)
  name           String     @db.VarChar(150)
  document       String?    @db.VarChar(14)
  phone          String?    @db.VarChar(20)
  email          String?    @db.VarChar(254)
  notes          String?    @db.Text
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialEntries FinancialEntry[]
  quotes           FinancialQuote[]
  orders           SalesOrder[]

  @@unique([organizationId, document])
  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, isActive])
  @@map("clients")
}

model Product {
  id                      String      @id @default(uuid()) @db.Uuid
  organizationId          String      @map("organization_id") @db.Uuid
  type                    ProductType @default(PRODUCT)
  name                    String      @db.VarChar(150)
  normalizedName          String      @map("normalized_name") @db.VarChar(150)
  sku                     String?     @db.VarChar(60)
  barcode                 String?     @db.VarChar(50)
  unit                    String      @db.VarChar(20)
  directCost              Decimal?    @map("direct_cost") @db.Decimal(18, 6)
  salePrice               Decimal?    @map("sale_price") @db.Decimal(14, 2)
  trackInventory          Boolean     @default(false) @map("track_inventory")
  minimumStock            Decimal?    @map("minimum_stock") @db.Decimal(18, 6)
  notes                   String?     @db.Text
  isActive                Boolean     @default(true) @map("is_active")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  adoptedPricingVersionId String?     @map("adopted_pricing_version_id") @db.Uuid

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  quoteItems     FinancialQuoteItem[]
  orderItems     SalesOrderItem[]

  pricingCompositions               ProductPricingComposition[] @relation("ProductPricingCompositionProduct")
  pricingSourceComponents           PricingComponent[]          @relation("PricingComponentSourceProduct")
  pricingVersions                   PricingCalculationVersion[] @relation("PricingVersionProduct")
  pricingHistoricalSourceComponents PricingVersionComponent[]   @relation("PricingVersionComponentSourceProduct")
  pricingAdoptions                  PricingPriceAdoption[]      @relation("PricingAdoptionProduct")

  adoptedPricingVersion PricingCalculationVersion? @relation("ProductAdoptedPricingVersion", fields: [organizationId, id, adoptedPricingVersionId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, normalizedName])
  @@index([organizationId, type, isActive])
  @@index([organizationId, id, adoptedPricingVersionId])
  @@map("products")
}

model FinancialQuote {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  clientId       String      @map("client_id") @db.Uuid
  number         Int
  status         QuoteStatus @default(DRAFT)
  validUntil     DateTime?   @map("valid_until") @db.Date
  subtotal       Decimal     @default(0) @db.Decimal(14, 2)
  discount       Decimal     @default(0) @db.Decimal(14, 2)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  notes          String?     @db.Text
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(3)
  approvedAt     DateTime?   @map("approved_at") @db.Timestamptz(3)
  rejectedAt     DateTime?   @map("rejected_at") @db.Timestamptz(3)
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  items        FinancialQuoteItem[]
  order        SalesOrder?          @relation("OrderSourceQuote")

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, clientId, createdAt])
  @@map("financial_quotes")
}

model FinancialQuoteItem {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  quoteId          String                 @map("quote_id") @db.Uuid
  productId        String?                @map("product_id") @db.Uuid
  priceOrigin      CommercialPriceOrigin? @map("price_origin")
  pricingVersionId String?                @map("pricing_version_id") @db.Uuid
  position         Int
  description      String                 @db.VarChar(160)
  unit             String                 @db.VarChar(20)
  quantity         Decimal                @db.Decimal(18, 6)
  unitPrice        Decimal                @map("unit_price") @db.Decimal(14, 2)
  total            Decimal                @db.Decimal(14, 2)
  notes            String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  quote          FinancialQuote             @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)
  product        Product?                   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  pricingVersion PricingCalculationVersion? @relation("QuoteItemPricingVersion", fields: [organizationId, productId, pricingVersionId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict, map: "financial_quote_items_pricing_version_fkey")

  @@unique([quoteId, position])
  @@index([organizationId, quoteId])
  @@index([organizationId, productId])
  @@index([organizationId, productId, pricingVersionId], map: "financial_quote_items_org_product_version_idx")
  @@map("financial_quote_items")
}

model SalesOrder {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  quoteId        String      @map("quote_id") @db.Uuid
  clientId       String      @map("client_id") @db.Uuid
  workflowId     String      @map("workflow_id") @db.Uuid
  currentStageId String      @map("current_stage_id") @db.Uuid
  number         Int
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @default(0) @db.Decimal(14, 2)
  discount       Decimal     @default(0) @db.Decimal(14, 2)
  total          Decimal     @default(0) @db.Decimal(14, 2)
  notes          String?     @db.Text
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote            FinancialQuote              @relation("OrderSourceQuote", fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  client           Client                      @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  workflow         OrderWorkflow               @relation(fields: [organizationId, workflowId], references: [organizationId, id], onDelete: Restrict)
  currentStage     OrderWorkflowStage          @relation("SalesOrderCurrentStage", fields: [organizationId, currentStageId], references: [organizationId, id], onDelete: Restrict)
  items            SalesOrderItem[]
  stageTransitions SalesOrderStageTransition[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, quoteId])
  @@index([organizationId, status])
  @@index([organizationId, currentStageId])
  @@index([organizationId, clientId, createdAt])
  @@map("orders")
}

model SalesOrderItem {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  orderId          String                 @map("order_id") @db.Uuid
  productId        String?                @map("product_id") @db.Uuid
  priceOrigin      CommercialPriceOrigin? @map("price_origin")
  pricingVersionId String?                @map("pricing_version_id") @db.Uuid
  position         Int
  description      String                 @db.VarChar(160)
  unit             String                 @db.VarChar(20)
  quantity         Decimal                @db.Decimal(18, 6)
  unitPrice        Decimal                @map("unit_price") @db.Decimal(14, 2)
  total            Decimal                @db.Decimal(14, 2)
  notes            String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  order          SalesOrder                 @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  product        Product?                   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  pricingVersion PricingCalculationVersion? @relation("OrderItemPricingVersion", fields: [organizationId, productId, pricingVersionId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict, map: "order_items_pricing_version_fkey")

  @@unique([orderId, position])
  @@index([organizationId, orderId])
  @@index([organizationId, productId])
  @@index([organizationId, productId, pricingVersionId], map: "order_items_org_product_version_idx")
  @@map("order_items")
}

model OrderWorkflow {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  normalizedName String   @map("normalized_name") @db.VarChar(100)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       OrderWorkflowStage[]
  orders       SalesOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, normalizedName])
  @@index([organizationId, isDefault, isActive])
  @@map("order_workflows")
}

model OrderWorkflowStage {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  workflowId     String             @map("workflow_id") @db.Uuid
  name           String             @db.VarChar(100)
  position       Int
  category       OrderStageCategory
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow            OrderWorkflow               @relation(fields: [organizationId, workflowId], references: [organizationId, id], onDelete: Cascade)
  currentOrders       SalesOrder[]                @relation("SalesOrderCurrentStage")
  previousTransitions SalesOrderStageTransition[] @relation("OrderStageTransitionPreviousStage")
  nextTransitions     SalesOrderStageTransition[] @relation("OrderStageTransitionNextStage")

  @@unique([organizationId, id])
  @@unique([workflowId, position])
  @@index([organizationId, workflowId, isActive])
  @@map("order_workflow_stages")
}

model SalesOrderStageTransition {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  orderId         String                   @map("order_id") @db.Uuid
  type            OrderStageTransitionType
  previousStageId String?                  @map("previous_stage_id") @db.Uuid
  nextStageId     String?                  @map("next_stage_id") @db.Uuid
  actorUserId     String?                  @map("actor_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order         SalesOrder          @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)
  previousStage OrderWorkflowStage? @relation("OrderStageTransitionPreviousStage", fields: [organizationId, previousStageId], references: [organizationId, id], onDelete: Restrict)
  nextStage     OrderWorkflowStage? @relation("OrderStageTransitionNextStage", fields: [organizationId, nextStageId], references: [organizationId, id], onDelete: Restrict)
  actor         User?               @relation("OrderStageTransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, orderId, createdAt])
  @@map("order_stage_transitions")
}

model StockMovement {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  type           StockMovementType
  origin         StockMovementOrigin @default(MANUAL)
  quantity       Decimal             @db.Decimal(18, 6)
  reason         String              @db.VarChar(255)
  notes          String?             @db.Text
  reversalOfId   String?             @unique @map("reversal_of_id") @db.Uuid
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   StockMovement? @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal     StockMovement? @relation("StockMovementReversal")

  @@index([organizationId, productId, occurredAt, id])
  @@index([organizationId, occurredAt, id])
  @@map("stock_movements")
}

model FinancialPeriod {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  year           Int                    @db.SmallInt
  month          Int                    @db.SmallInt
  status         FinancialPeriodStatus  @default(OPEN)
