{
  "name": "meinager",
  "version": "0.1.0",
  "private": "true",
  "description": "SaaS for managing small businesses",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "start": "turbo start:local",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "pilot:test": "node apps/web/test/pilot/pilot-postgres.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @meinager/api prisma:generate",
    "db:deploy": "pnpm --filter @meinager/api exec prisma migrate deploy",
    "db:migrate": "pnpm --filter @meinager/api prisma:migrate",
    "db:status": "pnpm --filter @meinager/api prisma:status",
    "db:studio": "pnpm --filter @meinager/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
